#!/bin/sh
# Smart queue management for the internet connection (docs/sqm.md). The daemon writes /etc/default/peakroute-sqm while shaping is on and
# removes it when it is off; this makes the kernel match: the cake queue discipline on the connection for what goes out, and, for what comes
# in, an ifb device that the incoming packets are redirected to and cake shapes there.
#
#   sqm reconcile     with the file: start; without it: stop        (what a commit runs)
#   sqm start         shape the device named in the file            (also safe to run again: it replaces)
#   sqm start-if DEV  start, but only when DEV is the device the file names (the hooks that run when an interface comes up)
#   sqm stop          take the shaping away again
#
# With SQM_CLASSES in the file (a share of the line for each network, docs/sqm.md "Per network") the line is not one cake queue but a tree:
# an htb class for the whole line, a class for each network under it (an assured rate, a ceiling, a priority), and in each a cake queue that
# only shares the class between the devices. Packets are sorted by the mark the firewall put on their connection: what goes out carries it
# on the packet, what comes in is given it from the connection tracking (the ctinfo action) on its way to the ifb device.
#
# A router with two internet connections shapes each with its own speeds: the file has SQM_* for the first and SQM2_* for the second
# (SQM2_DEV, SQM2_UP_KBIT, ...), and each connection has an ifb device of its own (ifb-wan, ifb-wan2).
#
# SQM_CONF, SQM_STATE and SQM_STATE2 can name other files (the tests do).
set -u
CONF="${SQM_CONF:-/etc/default/peakroute-sqm}"
STATE="${SQM_STATE:-/run/peakroute/sqm.dev}"
STATE2="${SQM_STATE2:-/run/peakroute/sqm2.dev}"
IFB="ifb-wan"

say() { echo "sqm: $*"; }

# the pieces the kernel needs, as modules (a kernel with them built in has no module to load)
load_modules() {
    for m in sch_cake ifb act_mirred cls_matchall sch_htb cls_fw act_ctinfo; do modprobe -q "$m" 2>/dev/null || true; done
}

link_keyword() {
    case "$1" in
        docsis) echo docsis ;;
        vdsl) echo pppoe-ptm ;;
        adsl) echo pppoe-vcmux ;;
        *) echo ethernet ;;
    esac
}

# what the link adds to each packet, as htb's size table wants it: overhead, link layer, smallest packet
link_stab() {
    case "$1" in
        docsis) echo "overhead 18 linklayer ethernet mpu 64" ;;
        vdsl) echo "overhead 30 linklayer ethernet" ;;
        adsl) echo "overhead 32 linklayer atm" ;;
        *) echo "overhead 38 linklayer ethernet mpu 84" ;;
    esac
}

# build the tree of shares on a device for one direction: $1 device, $2 the whole line (kbit/s), $3 "up" or "down", $4 the cake keywords
# for fairness between devices, $5 more cake keywords
build_tree() {
    dev="$1"; total="$2"; side="$3"; fair="$4"; more="$5"
    tc qdisc del dev "$dev" root 2>/dev/null || true
    # shellcheck disable=SC2046
    tc qdisc add dev "$dev" root handle 1: stab $(link_stab "${SQM_LINK:-ethernet}") htb default 2 r2q 10 || return 1
    tc class add dev "$dev" parent 1: classid 1:1 htb rate "${total}kbit" ceil "${total}kbit" quantum 6000 || return 1
    list="$(mktemp)"
    printf '%s\n' "$SQM_CLASSES" > "$list"
    while read -r mark minor prio up_r up_c down_r down_c; do
        [ -n "$mark" ] || continue
        if [ "$side" = up ]; then rate="$up_r"; ceil="$up_c"; else rate="$down_r"; ceil="$down_c"; fi
        [ "$rate" -ge 1 ] 2>/dev/null || continue
        tc class add dev "$dev" parent 1:1 classid "1:$minor" htb rate "${rate}kbit" ceil "${ceil}kbit" prio "$prio" quantum 6000 || { rm -f "$list"; return 1; }
        # shellcheck disable=SC2086
        tc qdisc add dev "$dev" parent "1:$minor" handle "$minor:" cake unlimited besteffort $fair nat $more raw || { rm -f "$list"; return 1; }
        if [ "$mark" != "0x0" ]; then
            tc filter add dev "$dev" parent 1: protocol all prio 1 handle "$mark/0x00ff0000" fw classid "1:$minor" || { rm -f "$list"; return 1; }
        fi
    done < "$list"
    rm -f "$list"
}

# take away what is on a device and on its ifb (nothing there is not an error): $1 the device, $2 the ifb device ($IFB when not given)
clear_shaping() {
    dev="$1"
    [ -n "$dev" ] || return 0
    tc qdisc del dev "$dev" root 2>/dev/null || true
    tc qdisc del dev "$dev" ingress 2>/dev/null || true
    ip link del "${2:-$IFB}" 2>/dev/null || true
}

# stop_line takes the shaping away from the device a state file names: $1 the state file, $2 its ifb device
stop_line() {
    dev=""
    [ -f "$1" ] && dev="$(cat "$1")"
    # a device named in the file that is being taken away is known from the state; one that was never started has nothing to stop
    clear_shaping "$dev" "$2"
    rm -f "$1"
}

stop() {
    stop_line "$STATE" ifb-wan
    stop_line "$STATE2" ifb-wan2
}

# shape_line shapes one internet connection: $1 device, $2 upload and $3 download (kbit/s), $4 kind of line, $5 per-device fairness (1 or 0),
# $6 the shares of the networks (or empty), $7 the ifb device, $8 the state file
shape_line() {
    dev="$1"; up="$2"; down="$3"; SQM_LINK="$4"; SQM_PERHOST="$5"; SQM_CLASSES="$6"; IFB="$7"; state="$8"
    ip link show "$dev" >/dev/null 2>&1 || { say "$dev is not there (yet): it is shaped when it comes up"; return 0; }
    kw="$(link_keyword "${SQM_LINK:-ethernet}")"
    # (every keyword is given every time: replacing a queue keeps what is not named, so a setting taken away would stay)
    if [ "${SQM_PERHOST:-1}" = "1" ]; then out_fair="dual-srchost"; in_fair="dual-dsthost"; else out_fair="triple-isolate"; in_fair="triple-isolate"; fi

    # a device that was shaped before and is not any more
    if [ -f "$state" ] && [ "$(cat "$state")" != "$dev" ]; then clear_shaping "$(cat "$state")" "$IFB"; fi
    mkdir -p "$(dirname "$state")"
    if [ "$up" -gt 0 ]; then
        if [ -n "${SQM_CLASSES:-}" ]; then
            build_tree "$dev" "$up" up "$out_fair" "" \
                || { say "cannot divide what goes out on $dev between the networks" >&2; return 1; }
        else
            # a tree from before is taken away first: replacing keeps what is not named
            tc qdisc del dev "$dev" root 2>/dev/null || true
            # shellcheck disable=SC2086
            tc qdisc add dev "$dev" root cake bandwidth "${up}kbit" diffserv3 $out_fair nat nowash "$kw" \
                || { say "cannot shape what goes out on $dev (is the cake queue discipline in this kernel?)" >&2; return 1; }
        fi
    else
        tc qdisc del dev "$dev" root 2>/dev/null || true
    fi

    if [ "$down" -gt 0 ]; then
        ip link show "$IFB" >/dev/null 2>&1 || ip link add "$IFB" type ifb \
            || { say "cannot make the $IFB device for what comes in" >&2; return 1; }
        ip link set "$IFB" up
        tc qdisc replace dev "$dev" handle ffff: ingress \
            || { say "cannot shape what comes in on $dev" >&2; return 1; }
        tc filter del dev "$dev" parent ffff: 2>/dev/null || true
        if [ -n "${SQM_CLASSES:-}" ]; then
            # the connection's mark goes onto the packet on its way to the ifb, where the classes are told apart by it
            tc filter add dev "$dev" parent ffff: protocol all prio 10 matchall action ctinfo cpmark 0x00ff0000 pipe action mirred egress redirect dev "$IFB" \
                || { say "cannot send what comes in to $IFB (is the ctinfo action in this kernel?)" >&2; return 1; }
            build_tree "$IFB" "$down" down "$in_fair" "wash" \
                || { say "cannot divide what comes in on $IFB between the networks" >&2; return 1; }
        else
            tc filter add dev "$dev" parent ffff: protocol all prio 10 matchall action mirred egress redirect dev "$IFB" \
                || { say "cannot send what comes in to $IFB" >&2; return 1; }
            tc qdisc del dev "$IFB" root 2>/dev/null || true
            # shellcheck disable=SC2086
            tc qdisc add dev "$IFB" root cake bandwidth "${down}kbit" diffserv3 $in_fair nat wash ingress "$kw" \
                || { say "cannot shape what comes in on $IFB" >&2; return 1; }
        fi
    else
        tc qdisc del dev "$dev" ingress 2>/dev/null || true
        ip link del "$IFB" 2>/dev/null || true
    fi
    echo "$dev" > "$state"
}


start() {
    [ -f "$CONF" ] || { say "no configuration: nothing to start"; return 0; }
    # shellcheck disable=SC1090
    . "$CONF"
    load_modules
    rc=0
    first_dev="${SQM_DEV:-}"
    second_dev="${SQM2_DEV:-}"
    # (the second connection's variables are taken out of the first's names before the first is shaped: shape_line sets them)
    s2_up="${SQM2_UP_KBIT:-0}"; s2_down="${SQM2_DOWN_KBIT:-0}"; s2_link="${SQM2_LINK:-ethernet}"; s2_perhost="${SQM2_PERHOST:-1}"; s2_classes="${SQM2_CLASSES:-}"
    s1_up="${SQM_UP_KBIT:-0}"; s1_down="${SQM_DOWN_KBIT:-0}"; s1_link="${SQM_LINK:-ethernet}"; s1_perhost="${SQM_PERHOST:-1}"; s1_classes="${SQM_CLASSES:-}"
    if [ -n "$first_dev" ]; then
        shape_line "$first_dev" "$s1_up" "$s1_down" "$s1_link" "$s1_perhost" "$s1_classes" ifb-wan "$STATE" || rc=1
    else
        stop_line "$STATE" ifb-wan
    fi
    if [ -n "$second_dev" ]; then
        shape_line "$second_dev" "$s2_up" "$s2_down" "$s2_link" "$s2_perhost" "$s2_classes" ifb-wan2 "$STATE2" || rc=1
    else
        stop_line "$STATE2" ifb-wan2
    fi
    [ -n "$first_dev$second_dev" ] || { say "the configuration names no device" >&2; return 1; }
    return $rc
}

case "${1:-}" in
    reconcile) if [ -f "$CONF" ]; then start; else stop; fi ;;
    start) start ;;
    start-if)
        [ -f "$CONF" ] || exit 0
        # shellcheck disable=SC1090
        . "$CONF"
        if [ "${2:-}" = "${SQM_DEV:-}" ] || [ "${2:-}" = "${SQM2_DEV:-}" ]; then start; fi
        exit 0 ;;
    stop) stop ;;
    *) echo "usage: sqm reconcile | start | start-if DEVICE | stop" >&2; exit 2 ;;
esac
