#!/bin/sh
# udhcpc's script for the internet connections of a router that has two of them (docs/wan-failover.md). Debian's own script gives every
# default route the same metric, so the second connection's would be refused, and lets every connection write the resolver file. This
# one gives the default route the metric of the interface's stanza (IF_METRIC, which ifupdown hands over from its "metric" line) and
# writes the resolver file from the resolvers of every connection that has a lease, the lowest metric (the one that carries the traffic)
# first: a provider's resolvers often answer only its own customers, so after a failover the other connection's are needed. The domain
# and search list are the first connection's only (the stanza of the second says "peakroute-resolv no": IF_PEAKROUTE_RESOLV). With one
# connection the router runs Debian's script. udhcpc passes: $1 (deconfig, bound, renew, leasefail, nak) and $interface, $ip, $mask,
# $subnet, $broadcast, $router, $dns, $domain, $search, $mtu.

# (the tests point these elsewhere)
RUN="${PEAKROUTE_RUN:-/run/peakroute}"
RESOLV_CONF="${PEAKROUTE_RESOLV_CONF:-/etc/resolv.conf}"
RESOLVCONF="${PEAKROUTE_RESOLVCONF:-/sbin/resolvconf}" # the program some systems have for it
STATE="$RUN/udhcpc.${interface}"
METRIC="${IF_METRIC:-0}"

log() { logger -t "udhcpc[$PPID]" -p "daemon.$1" "$interface: $2" 2>/dev/null || true; }

# drop forgets the default route this script set last time
drop() {
    [ -f "$STATE" ] || return 0
    old_router=$(sed -n 's/^router=//p' "$STATE")
    old_metric=$(sed -n 's/^metric=//p' "$STATE")
    [ -n "$old_router" ] && ip -4 route del default via "$old_router" dev "$interface" metric "${old_metric:-0}" 2>/dev/null
    rm -f "$STATE"
}

# write_resolvers makes the resolver file out of what every connection has (their state files, written below): nameservers by metric
write_resolvers() {
    [ "${IF_PEAKROUTE_RESOLV:-}" != no ] && { own_domain="$domain"; own_search="$search"; } || { own_domain=""; own_search=""; }
    R="$(
        [ -z "$own_domain" ] || echo "domain $own_domain"
        [ -z "$own_search" ] || echo "search $own_search"
        for f in "$RUN"/udhcpc.*; do
            [ -f "$f" ] || continue
            m=$(sed -n 's/^metric=//p' "$f")
            for s in $(sed -n 's/^dns=//p' "$f"); do echo "${m:-0} $s"; done
        done | sort -n -s -k1,1 | awk '!seen[$2]++ { print "nameserver " $2 }'
    )"
    if [ -x "$RESOLVCONF" ]; then
        echo "$R" | "$RESOLVCONF" -a "$interface.udhcpc"
    else
        # the domain and search lines of the other connection are kept when this one has none
        if [ -z "$own_domain$own_search" ] && [ -f "$RESOLV_CONF" ]; then
            keep="$(grep -E '^(domain|search) ' "$RESOLV_CONF" 2>/dev/null)"
            [ -z "$keep" ] || R="$keep
$R"
        fi
        echo "$R" > "$RESOLV_CONF.peakroute.$$" && mv "$RESOLV_CONF.peakroute.$$" "$RESOLV_CONF"
    fi
}

case "$1" in
    deconfig)
        ip link set "$interface" up
        drop
        ip -4 addr flush dev "$interface"
        [ -x "$RESOLVCONF" ] && "$RESOLVCONF" -d "$interface.udhcpc"
        # what this connection told is no longer true: the other's resolvers stay
        domain="" search="" dns=""
        write_resolvers
        log notice "deconfigured"
        ;;
    bound|renew)
        ip -4 addr replace "$ip/${mask:-24}" ${broadcast:+broadcast "$broadcast"} dev "$interface"
        [ -n "$mtu" ] && ip link set dev "$interface" mtu "$mtu"
        router="${router%% *}"
        [ "$subnet" = 255.255.255.255 ] && onlink=onlink || onlink=
        old_router=$(sed -n 's/^router=//p' "$STATE" 2>/dev/null)
        old_metric=$(sed -n 's/^metric=//p' "$STATE" 2>/dev/null)
        if [ "$old_router" != "$router" ] || [ "${old_metric:-0}" != "$METRIC" ]; then
            drop
        fi
        if [ -n "$router" ]; then
            ip -4 route replace default via "$router" dev "$interface" metric "$METRIC" $onlink
        fi
        mkdir -p "$RUN"
        # (the resolvers are kept in the state file: the resolver file is made from all of them, and the health check asks them)
        printf 'router=%s\nmetric=%s\ndns=%s\n' "$router" "$METRIC" "$dns" > "$STATE"
        write_resolvers
        log info "$1: $ip/${mask:-24} router=$router metric=$METRIC dns=\"$dns\""
        ;;
    leasefail|nak)
        log err "no lease: $1 ${message:-}"
        ;;
esac
exit 0
