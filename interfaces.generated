auto lo
iface lo inet loopback

# WAN Interface
auto eth0
iface eth0 inet dhcp

# LAN Member Ports
auto eth1
iface eth1 inet manual

auto eth2
iface eth2 inet manual

auto eth3
iface eth3 inet manual

# LAN Bridge
auto br0
iface br0 inet static
    address 192.168.1.1
    netmask 255.255.255.0
    bridge_ports eth1 eth2 eth3
    bridge_stp off
    bridge_fd 0
